{
  "expo": {
    "name": "VELTRIX",
    "slug": "Veltrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mmicon1.png",
    "scheme": "veltrix",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.swagatobauri.veltrix",
      "adaptiveIcon": {
        "backgroundColor": "#25252D",
        "foregroundImage": "./assets/images/mmicon1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
        [
        "expo-splash-screen",
        {
          "backgroundColor": "#25252D",
          "image": "./assets/images/mmicon1.png",
          "imageWidth": 500,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57489128-4fbe-4155-9d0f-4f38337e03d1"
      }
    },
    "owner": "swagatobauri"
  }
}
